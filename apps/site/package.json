{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "postbuild": "node scripts/verify-built-assets.mjs",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run --config vitest.config.ts",
    "test:build-assets": "node scripts/test-rsc-css-build.mjs && node scripts/test-built-browser-fixture.mjs",
    "test:sina-runtime": "node scripts/test-sina-runtime.mjs",
    "test:ashare-backoff-runtime": "node scripts/test-ashare-backoff-runtime.mjs",
    "test:ashare-runtime": "node scripts/test-ashare-runtime.mjs",
    "test:fx-runtime": "node scripts/test-fx-runtime.mjs",
    "test:kraken-runtime": "node scripts/test-kraken-runtime.mjs",
    "test:cftc-runtime": "node scripts/test-cftc-runtime.mjs",
    "test:tpex-runtime": "node scripts/test-tpex-runtime.mjs",
    "test:tpex-summary-runtime": "node scripts/test-tpex-summary-runtime.mjs && node scripts/test-tpex-summary-races.mjs",
    "test:asean-runtime": "node scripts/test-asean-runtime.mjs",
    "test:cvm-runtime": "node scripts/test-cvm-runtime.mjs",
    "test:equity-runtime": "node scripts/test-equity-runtime.mjs",
    "test:ashare-snapshots-runtime": "node scripts/test-ashare-snapshots-runtime.mjs",
    "test:ashare-staged-runtime": "node scripts/test-ashare-staged-runtime.mjs",
    "test:polymarket-runtime": "node scripts/test-polymarket-runtime.mjs",
    "test:cboe-runtime": "node scripts/test-cboe-runtime.mjs",
    "test:japan-mof-runtime": "node scripts/test-japan-mof-runtime.mjs",
    "test:polymarket-interest-runtime": "node scripts/test-polymarket-interest-runtime.mjs",
    "test:tic-runtime": "node scripts/test-tic-runtime.mjs",
    "test:ashare-scheduler-runtime": "node scripts/test-ashare-scheduler-runtime.mjs",
    "scheduler:status": "node scripts/check-ashare-scheduler.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "d3-geo": "^3.1.1",
    "d3-hierarchy": "^3.1.3",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "saxes": "6.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "topojson-client": "^3.1.0",
    "vaul": "^1.1.2",
    "world-atlas": "2.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/react": "^16.3.0",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/geojson": "^7946.0.16",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "jsdom": "^26.1.0",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "vitest": "^3.2.7",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
