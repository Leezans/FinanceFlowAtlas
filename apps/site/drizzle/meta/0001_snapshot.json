        "ashare_gate_id": {
          "name": "ashare_gate_id",
          "value": "\"ashare_source_gate\".\"id\" = 'single_upstream'"
        },
        "ashare_gate_status": {
          "name": "ashare_gate_status",
          "value": "\"ashare_source_gate\".\"status\" IN ('idle','busy','blocked')"
        },
        "ashare_gate_reason": {
          "name": "ashare_gate_reason",
          "value": "\"ashare_source_gate\".\"reason_code\" IS NULL OR \"ashare_source_gate\".\"reason_code\" IN ('http_403','http_429','challenge','captcha','access_denied','login_required')"
        },
        "ashare_gate_lease": {
          "name": "ashare_gate_lease",
          "value": "(\"ashare_source_gate\".\"status\" = 'busy' AND \"ashare_source_gate\".\"lease_token\" IS NOT NULL) OR (\"ashare_source_gate\".\"status\" != 'busy' AND \"ashare_source_gate\".\"lease_token\" IS NULL)"
        },
        "ashare_gate_block": {
          "name": "ashare_gate_block",
          "value": "(\"ashare_source_gate\".\"status\" = 'blocked' AND \"ashare_source_gate\".\"reason_code\" IS NOT NULL) OR (\"ashare_source_gate\".\"status\" != 'blocked' AND \"ashare_source_gate\".\"reason_code\" IS NULL)"
        }
      }
