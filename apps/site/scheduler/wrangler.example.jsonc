{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "financeflowatlas-ashare-scheduler",
  "main": "worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ASHARE_SCHEDULER_ENABLED": "false",
    "ASHARE_SCHEDULER_SCOPES": "level1"
  },
  "triggers": {"crons": []},
  "d1_databases": [{
    "binding": "DB",
    "database_name": "REPLACE_WITH_EXISTING_PRIMARY_DATABASE_NAME",
    "database_id": "REPLACE_WITH_EXISTING_PRIMARY_DATABASE_ID"
  }]
}
